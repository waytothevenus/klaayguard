{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    "fs:default",
    "fs:read-file",
    "fs:write-file",
    "fs:create-dir",
    "fs:scope",
    "http:default",
    "http:request",
    "http:scope",
    "path:default",
    "os:default",
    "process:default",
    "process:relaunch",
    "process:relaunch-deps"
  ]
}