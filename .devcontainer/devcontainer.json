{
  "name": "Klaayguard",
  "service": "klaayguard",
  "workspaceFolder": "/app",
  "dockerComposeFile": "compose.yml",
  "customizations": {
    "vscode": {
      "extensions": ["eamodio.gitlens", "tauri-apps.tauri-vscode", "rust-lang.rust-analyzer"],
      "settings": {
        "files.insertFinalNewline": true,
        "editor.detectIndentation": true,
        "editor.tabSize": 2,
        "chat.promptFiles": true,
        "chat.agent.enabled": true
      }
    }
  }
}
